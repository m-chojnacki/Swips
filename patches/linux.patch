diff --git a/drivers/block/swipsdrive.c b/drivers/block/swipsdrive.c
new file mode 100644
index 000000000..6d157b210
--- /dev/null
+++ b/drivers/block/swipsdrive.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/module.h>
+#include <linux/blkdev.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+
+static bool swipsdrive_do_bvec(struct device *dev, struct bio_vec *bv, u32 pos)
+{
+    pr_info("swipsdrive: %u\n", pos);
+    return true;
+}
+
+static blk_qc_t swipsdrive_submit_bio(struct bio *bio)
+{
+	struct bio_vec bvec;
+	struct bvec_iter iter;
+	struct device *dev = bio->bi_bdev->bd_disk->private_data;
+	u32 pos = bio->bi_iter.bi_sector << SECTOR_SHIFT;
+
+	bio_for_each_segment(bvec, bio, iter) {
+		if (!swipsdrive_do_bvec(dev, &bvec, pos))
+			goto io_error;
+		pos += bvec.bv_len;
+	}
+
+	bio_endio(bio);
+	return BLK_QC_T_NONE;
+io_error:
+	bio_io_error(bio);
+	return BLK_QC_T_NONE;
+}
+
+static const struct block_device_operations swipsdrive_fops = {
+	.owner		= THIS_MODULE,
+	.submit_bio	= swipsdrive_submit_bio,
+};
+
+static int swipsdrive_probe(struct platform_device *pdev)
+{
+	struct gendisk *disk;
+
+	disk = alloc_disk(0);
+	if (!disk)
+		return -ENOMEM;
+
+	disk->queue = blk_alloc_queue(NUMA_NO_NODE);
+	if (!disk->queue)
+		return -ENOMEM;
+
+	disk->first_minor = 0;
+	disk->flags = GENHD_FL_NO_PART_SCAN | GENHD_FL_EXT_DEVT;
+	disk->fops = &swipsdrive_fops;
+	disk->private_data = &pdev->dev;
+	strcpy(disk->disk_name, "swipsdrive");
+
+	set_capacity(disk, 4096 >> SECTOR_SHIFT);
+	// set_disk_ro(disk, 1);
+
+	blk_queue_flag_set(QUEUE_FLAG_NONROT, disk->queue);
+	blk_queue_physical_block_size(disk->queue, 4096);
+	blk_queue_logical_block_size(disk->queue, 4096);
+
+	add_disk(disk);
+	
+	return 0;
+}
+
+static int swipsdrive_remove(struct platform_device *pdev)
+{
+	return 0;
+}
+
+#ifdef CONFIG_OF
+static const struct of_device_id swipsdrive_match[] = {
+	{ .compatible = "swips,drive", },
+	{},
+};
+MODULE_DEVICE_TABLE(of, swipsdrive_match);
+#endif /* CONFIG_OF */
+
+static struct platform_driver swipsdrive_driver = {
+	.probe		= swipsdrive_probe,
+	.remove		= swipsdrive_remove,
+	.driver	= {
+		.name	= "swipsdrive",
+		.of_match_table = of_match_ptr(swipsdrive_match),
+	},
+};
+module_platform_driver(swipsdrive_driver);
+
+MODULE_AUTHOR("Marcin Chojnacki <marcinch7@gmail.com>");
+MODULE_DESCRIPTION("Driver for the SwipsDrive");
+MODULE_LICENSE("GPL");
