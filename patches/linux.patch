diff --git a/arch/mips/boot/dts/swips/swips.dts b/arch/mips/boot/dts/swips/swips.dts
new file mode 100644
index 000000000..d1961ba59
--- /dev/null
+++ b/arch/mips/boot/dts/swips/swips.dts
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	
+	compatible = "swips,machine";
+	model = "Swips";
+	
+	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		
+		stdout-path = &serial0;
+		
+		framebuffer0: framebuffer@1a000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x1a000000 (800 * 600 * 2)>;
+			width = <800>;
+			height = <600>;
+			stride = <(800 * 2)>;
+			format = "r5g6b5";
+		};
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "swips,swipscore";
+			device_type = "cpu";
+			reg = <0>;
+			clocks = <&baseclk>;
+		};
+	};
+	
+	baseclk: baseclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <10000000>;
+	};
+	
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x8000000>;
+	};
+
+	serial0: serial@10030000 {
+		compatible = "ns8250";
+		reg = <0x10030000 0x100>;
+		reg-shift = <2>;
+		clocks = <&baseclk>;
+		current-speed = <115200>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <4>;
+		no-loopback-test;
+	};
+	
+	serial1: serial@10030100 {
+		compatible = "ns8250";
+		reg = <0x10030100 0x100>;
+		reg-shift = <2>;
+		clocks = <&baseclk>;
+		current-speed = <115200>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <5>;
+		no-loopback-test;
+	};
+	
+	keyboard: ps2@10040000 {
+		compatible = "altr,ps2-1.0";
+		reg = <0x10040000 0x100>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <3>;
+	};
+	
+	mouse: ps2@10040100 {
+		compatible = "altr,ps2-1.0";
+		reg = <0x10040100 0x100>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+	};
+	
+	swipsdrive: swipsdrive@11000000 {
+		compatible = "swips,drive";
+		reg = <0x11000000 0x01000000>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+	};
+};
